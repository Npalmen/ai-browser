{
  "name": "ai-browser",
  "productName": "AI Browser",
  "version": "0.1.0",
  "description": "AI-native desktop browser",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "typecheck": "tsc --noEmit",
    "test:url": "tsx --test src/shared/navigation-url.test.ts",
    "test:tabs": "tsx --test src/browser/tab-registry.test.ts",
    "test:observation": "tsx --test src/observation/redaction.test.ts src/observation/target-registry.test.ts src/observation/observation-builder.test.ts src/observation/document-identity.test.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/plugin-webpack": "^7.11.1",
    "@electron-forge/shared-types": "^7.11.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "css-loader": "^7.1.2",
    "electron": "^44.4.1",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "node-loader": "^2.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "webpack": "^5.99.5"
  }
}
